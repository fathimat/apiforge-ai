# Set in Render's backend Environment settings, not frontend build variables.
SPRING_PROFILES_ACTIVE=prod
# Use the Neon DIRECT hostname. Do not embed a username or password in the URL.
DATABASE_URL=jdbc:postgresql://ep-your-host.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
DATABASE_USER=replace-with-neon-role
DATABASE_PASSWORD=replace-with-neon-password
CORS_ALLOWED_ORIGINS=https://your-static-site.onrender.com
GEMINI_ENABLED=false
# PORT is assigned by Render. Do not set GEMINI_API_KEY.
